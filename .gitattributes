# Keep repository text deterministic across platforms and worktrees.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary artifacts must never be line-ending normalized.
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.onnx binary
*.pdf binary
*.png binary
*.safetensors binary
*.sqlite binary
*.sqlite3 binary
*.wasm binary
*.webp binary
*.zip binary
